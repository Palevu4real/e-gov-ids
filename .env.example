# ---- Postgres ----
POSTGRES_USER=ids_user
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=ids_db
DATABASE_URL=postgresql+asyncpg://ids_user:change_me_in_prod@postgres:5432/ids_db

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Kafka / Redpanda ----
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC_DETECTIONS=ids.detections
KAFKA_TOPIC_DLQ=ids.dlq

# ---- JWT ----
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- App ----
APP_ENV=development
APP_NAME=E-Gov IDS
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# ---- Detection Engine ----
CAPTURE_MODE=pcap           # pcap | live
PCAP_FILE=/pcaps/sample.pcap
FLOW_WINDOW_SECONDS=5
PUBLISH_ALL_FLOWS=false     # if true, publish non-detections too (debug)